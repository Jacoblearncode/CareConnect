# Local Postgres by default; point at Neon for a shared/dev-deployed database.
DATABASE_URL="postgresql://careconnect:careconnect@localhost:5432/careconnect"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-random-secret"

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

PORT=8787

# Optional — see docs/AI_PROVIDERS.md. Absent keys fall through the provider chain
# to scripted responses, so the companion works with none of these set.
CF_ACCOUNT_ID=
CF_WORKERS_AI_API_TOKEN=
GROQ_API_KEY=

# Optional — §11 escalation guidance. Neutral wording ("contact your local emergency
# services") is used when unset; set these to show a specific region's numbers instead.
ESCALATION_REGION=
ESCALATION_EMERGENCY_NUMBER=
ESCALATION_CRISIS_LINE_NAME=
ESCALATION_CRISIS_LINE_NUMBER=
